{
  "openapi": "3.0.3",
  "info": {
    "title": "WealthView API",
    "description": "Stellar treasury aggregation API for aggregating multiple Stellar wallet balances into a unified treasury view.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current deployment"
    }
  ],
  "paths": {
    "/api/aggregate": {
      "get": {
        "summary": "Aggregate Stellar treasury wallets",
        "description": "Aggregates Stellar Horizon balances for one or more wallets. Optional SEP-41 / Soroban contract IDs can be supplied for validated contract-token requests without changing classic Horizon aggregation behavior.",
        "parameters": [
          {
            "name": "wallets",
            "in": "query",
            "required": true,
            "description": "Comma-separated Stellar public wallet addresses.",
            "schema": {
              "type": "string"
            },
            "example": "GBGI5DB6EYA7W6BKVM7I6L5F3EIVUP4LSQC6AOE6DU7VWXAURFVLHO52,GDUY7J7A33TQWOSOQGDO776GGLM3UQERL4J3SPT56F6YS4ID7MLDERI4"
          },
          {
            "name": "contracts",
            "in": "query",
            "required": false,
            "description": "Optional comma-separated SEP-41 / Soroban token contract IDs. Contract balances are only included when Soroban RPC support is enabled; otherwise IDs are validated and reported in metadata/errors.",
            "schema": {
              "type": "string"
            },
            "example": "C..."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful aggregation response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AggregateResponse"
                },
                "example": {
                  "success": true,
                  "timestamp": "2026-05-23T12:00:00.000Z",
                  "version": "1.0.0",
                  "walletCount": 2,
                  "totalXLM": 1234.56,
                  "totalUSD": 145.67,
                  "pricedAssets": [
                    "XLM",
                    "USDZ"
                  ],
                  "unpricedAssets": [],
                  "assets": [
                    {
                      "symbol": "XLM",
                      "amount": 1234.56,
                      "usdValue": 145.67,
                      "allocationPercent": 96.12
                    },
                    {
                      "symbol": "USDZ",
                      "amount": 5000,
                      "usdValue": 5.89,
                      "allocationPercent": 3.88
                    }
                  ],
                  "errors": []
                }
              }
            }
          },
          "400": {
            "description": "Bad request (missing or invalid wallets parameter)"
          },
          "500": {
            "description": "Server-side aggregation error"
          }
        }
      }
    },
    "/api/signals": {
      "get": {
        "summary": "Generate Treasury Signals",
        "description": "Returns Treasury Signals generated from the same aggregate data. Optional SEP-41 / Soroban contract IDs are forwarded to the aggregate endpoint.",
        "parameters": [
          {
            "name": "wallets",
            "in": "query",
            "required": true,
            "description": "Comma-separated Stellar public wallet addresses.",
            "schema": {
              "type": "string"
            },
            "example": "GBGI5DB6EYA7W6BKVM7I6L5F3EIVUP4LSQC6AOE6DU7VWXAURFVLHO52,GDUY7J7A33TQWOSOQGDO776GGLM3UQERL4J3SPT56F6YS4ID7MLDERI4"
          },
          {
            "name": "contracts",
            "in": "query",
            "required": false,
            "description": "Optional comma-separated SEP-41 / Soroban token contract IDs. Contract balances are only included when Soroban RPC support is enabled; otherwise IDs are validated and reported in metadata/errors.",
            "schema": {
              "type": "string"
            },
            "example": "C..."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Treasury Signals response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalsResponse"
                },
                "example": {
                  "success": true,
                  "timestamp": "2026-05-23T12:00:00.000Z",
                  "walletCount": 2,
                  "signals": {
                    "assetConcentration": {
                      "severity": "watch",
                      "value": 92,
                      "message": "High asset concentration: XLM represents 92% of priced treasury value."
                    },
                    "walletConcentration": {
                      "severity": "good",
                      "value": null,
                      "message": "Wallet distribution looks balanced."
                    },
                    "unpricedAssets": {
                      "severity": "info",
                      "value": 0,
                      "message": "All detected assets are priced."
                    },
                    "stableExposure": {
                      "severity": "info",
                      "value": 12,
                      "message": "Stable asset exposure: 12% of priced treasury value."
                    },
                    "idleTreasury": {
                      "severity": "watch",
                      "value": true,
                      "message": "Potential idle treasury: most value is concentrated in one asset."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (missing or invalid wallets parameter)"
          },
          "500": {
            "description": "Server-side signals error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AggregateResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string"
          },
          "walletCount": {
            "type": "integer"
          },
          "totalXLM": {
            "type": "number"
          },
          "totalUSD": {
            "type": "number"
          },
          "pricedAssets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unpricedAssets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AggregatedAsset"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WalletError"
            }
          },
          "contracts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional requested SEP-41 / Soroban contract IDs."
          },
          "sep41": {
            "type": "object",
            "description": "Optional SEP-41 support metadata when contracts are supplied.",
            "properties": {
              "supported": {
                "type": "boolean"
              },
              "requestedContracts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "success",
          "timestamp",
          "version",
          "walletCount",
          "totalXLM",
          "totalUSD",
          "pricedAssets",
          "unpricedAssets",
          "assets",
          "errors"
        ]
      },
      "AggregatedAsset": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "usdValue": {
            "type": [
              "number",
              "null"
            ]
          },
          "allocationPercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "assetType": {
            "type": "string",
            "description": "Optional asset type such as classic or sep41."
          },
          "contractId": {
            "type": "string",
            "description": "SEP-41 / Soroban contract ID when assetType is sep41."
          },
          "name": {
            "type": "string",
            "description": "Optional token display name."
          },
          "decimals": {
            "type": "integer",
            "description": "Optional token decimals."
          },
          "rawAmount": {
            "type": "string",
            "description": "Raw SEP-41 contract balance before decimal conversion."
          },
          "source": {
            "type": "string",
            "description": "Balance source such as horizon or soroban."
          }
        }
      },
      "WalletError": {
        "type": "object",
        "properties": {
          "wallet": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "contractId": {
            "type": "string",
            "description": "Soroban contract ID when the error is associated with a requested SEP-41 contract."
          }
        }
      },
      "SignalsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "walletCount": {
            "type": "integer"
          },
          "signals": {
            "$ref": "#/components/schemas/TreasurySignals"
          },
          "contracts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional requested SEP-41 / Soroban contract IDs."
          }
        },
        "required": [
          "success",
          "timestamp",
          "walletCount",
          "signals"
        ]
      },
      "TreasurySignals": {
        "type": "object",
        "properties": {
          "assetConcentration": {
            "$ref": "#/components/schemas/TreasurySignal"
          },
          "walletConcentration": {
            "$ref": "#/components/schemas/TreasurySignal"
          },
          "unpricedAssets": {
            "$ref": "#/components/schemas/TreasurySignal"
          },
          "stableExposure": {
            "$ref": "#/components/schemas/TreasurySignal"
          },
          "idleTreasury": {
            "$ref": "#/components/schemas/TreasurySignal"
          }
        }
      },
      "TreasurySignal": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "good",
              "watch",
              "info"
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "value",
          "message"
        ]
      }
    }
  }
}
